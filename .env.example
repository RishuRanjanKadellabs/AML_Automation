# dev | qa | uat | production — see fixtures/environments.json (module paths/slugs are the same across envs)
ENV=dev
BASE_URL=https://kadelamldev.customerxps.com:2506
# QA example: ENV=qa  (or BASE_URL=https://kadelamlqa.customerxps.com:2502)
# 2506 Command Center — session login REQUIRED for every module (do not commit real passwords)
# Opt out only with PW_SKIP_AML_LOGIN=1. Negative/RBAC cases need QA_INCLUDE_AUTH_CASES=1.
EMAIL=QAUSER2
PASSWORD=
AML_USERNAME=
AML_PASSWORD=
LOGGED_USERNAME=QAUSER2
CURRENT_USER_GROUP=
PW_WORKERS=3
# Shared worker count for all auto-discovered milestoneN projects (default: 6 headless / 3 headed)
# PW_MILESTONE_WORKERS=3
# Legacy alias (still supported):
# PW_MILESTONE1_WORKERS=3
# Optional filter — only load these milestone projects (comma-separated numbers or names)
# PW_MILESTONES=1,2
# Skip slow post-run reports during dev runs (set by milestone1:kyc-gap-report:run)
# PW_SKIP_ALLURE_REPORT=1
# PW_SKIP_HTML_REPORT=1
# Path to Excel test cases (optional — defaults to pipeline/test-cases/)
# PIPELINE_INPUT=pipeline/test-cases/your-tests.xlsx
# Set to 1 to skip auto Allure HTML after tests (raw results still written)
PW_SKIP_ALLURE_REPORT=
# Set to 1 to include all results/* env folders in Allure (default: ENV only)
ALLURE_COLLECT_ALL=
