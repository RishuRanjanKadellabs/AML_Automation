{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/generated/qa-pipeline/schemas/human-readable-testcase-schema.json",
  "title": "QA Automation Pipeline Human-Readable Test Case Schema",
  "description": "Normalized, human-readable test case produced from Excel rows. Do not invent business rules, credentials, API details, locators, expected values, or test data.",
  "type": "object",
  "required": [
    "testCaseId",
    "title",
    "source",
    "steps",
    "finalExpectedResult",
    "automationFeasibility",
    "assumptions",
    "missingInformationWarnings"
  ],
  "properties": {
    "testCaseId": {
      "type": "string",
      "minLength": 1
    },
    "internalTraceId": {
      "type": "string",
      "description": "Assigned only when Excel ID missing; still preserves excelRowNumber"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "businessObjective": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirementReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testData": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "sensitive": {
            "type": "boolean",
            "default": false
          },
          "source": {
            "type": "string",
            "enum": [
              "excel",
              "env",
              "fixture",
              "assumption"
            ]
          }
        },
        "required": [
          "name",
          "value",
          "source"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stepNumber",
          "action"
        ],
        "properties": {
          "stepNumber": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string"
          },
          "expectedResult": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "finalExpectedResult": {
      "type": "string"
    },
    "priority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        null
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "boundary",
        "exception",
        "unknown"
      ]
    },
    "functionalArea": {
      "type": [
        "string",
        "null"
      ]
    },
    "automationFeasibility": {
      "type": "object",
      "required": [
        "rating",
        "rationale"
      ],
      "properties": {
        "rating": {
          "type": "string",
          "enum": [
            "automatable",
            "partial",
            "manual-only",
            "blocked",
            "needs-clarification"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "required"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "missingInformationWarnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "excelFile",
        "excelRowNumber"
      ],
      "properties": {
        "excelFile": {
          "type": "string"
        },
        "worksheetName": {
          "type": [
            "string",
            "null"
          ]
        },
        "excelRowNumber": {
          "type": "integer"
        },
        "originalTestCaseId": {
          "type": "string"
        }
      }
    }
  }
}
