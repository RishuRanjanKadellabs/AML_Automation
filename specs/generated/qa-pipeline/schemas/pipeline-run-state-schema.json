{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/generated/qa-pipeline/schemas/pipeline-run-state-schema.json",
  "title": "QA Pipeline Run Checkpoint",
  "type": "object",
  "required": ["excelPath", "currentStage", "status", "updatedAt"],
  "properties": {
    "excelPath": { "type": "string", "minLength": 1 },
    "resultsRoot": { "type": "string", "minLength": 1 },
    "resultsKey": { "type": "string", "minLength": 1 },
    "pipelineMode": { "type": "string", "enum": ["create", "reconcile"] },
    "tcDeltaReportPath": { "type": ["string", "null"] },
    "currentStage": {
      "enum": ["validate", "normalize", "batchPlan", "batchLoop", "report", "gate", "done"]
    },
    "status": {
      "enum": [
        "in_progress",
        "awaiting_resume",
        "awaiting_batch_approval",
        "blocked",
        "done"
      ]
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "batchCount": { "const": 6 },
    "currentBatchIndex": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
    "nextBatchIndex": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
    "awaitingBatchApproval": { "type": "boolean" },
    "lastCompletedBatchIndex": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
    "lastBatchCounts": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "preHeal": { "type": "object" },
        "postHeal": { "type": ["object", "null"] }
      }
    },
    "batchPlanPath": { "type": "string" },
    "batches": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["index", "status"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 6 },
          "status": { "type": "string" },
          "generatedCount": { "type": "integer", "minimum": 0 },
          "preHealCounts": { "type": "object" },
          "postHealCounts": { "type": ["object", "null"] },
          "healerInvoked": { "type": "boolean" }
        }
      }
    }
  }
}
