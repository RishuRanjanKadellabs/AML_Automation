{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/generated/fsd-figma-pipeline/schemas/stage0-atomicity-report-schema.json",
  "title": "Stage 0 Atomicity Gate Report",
  "type": "object",
  "required": [
    "resultsKey",
    "excelPath",
    "validatedAt",
    "atomicityReady",
    "testCaseCount",
    "inScopeRequirements",
    "errorCount",
    "violations"
  ],
  "properties": {
    "resultsKey": { "type": "string" },
    "excelPath": { "type": "string" },
    "validatedAt": { "type": "string" },
    "atomicityReady": { "type": "boolean" },
    "fineGrainReady": { "type": "boolean" },
    "gateReady": { "type": "boolean" },
    "minimumFineGrainTcCount": { "type": "integer", "minimum": 0 },
    "fineGrainSlotCount": { "type": "integer", "minimum": 0 },
    "uncoveredFineGrainSlotCount": { "type": "integer", "minimum": 0 },
    "testCaseCount": { "type": "integer", "minimum": 0 },
    "inScopeRequirements": { "type": "integer", "minimum": 0 },
    "useCaseCount": { "type": "integer", "minimum": 0 },
    "multiRequirementUseCaseCount": { "type": "integer", "minimum": 0 },
    "negativeEligibleRequirementCount": { "type": "integer", "minimum": 0 },
    "designTypeCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "errorCount": { "type": "integer", "minimum": 0 },
    "warningCount": { "type": "integer", "minimum": 0 },
    "rulesApplied": {
      "type": "array",
      "items": { "type": "string" }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "message": { "type": "string" },
          "testCaseId": { "type": "string" },
          "useCaseId": { "type": "string" },
          "requirementId": { "type": "string" },
          "requirementIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "testCaseIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
