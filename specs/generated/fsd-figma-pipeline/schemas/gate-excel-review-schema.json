{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/generated/fsd-figma-pipeline/schemas/gate-excel-review-schema.json",
  "title": "Stage 0 Excel Review Gate",
  "type": "object",
  "required": ["resultsKey", "excelPath", "status", "updatedAt"],
  "properties": {
    "resultsKey": { "type": "string" },
    "excelPath": { "type": "string" },
    "excelMode": { "type": "string", "enum": ["create", "reconcile"] },
    "milestone": { "type": "integer", "enum": [1, 2] },
    "status": {
      "type": "string",
      "enum": [
        "BlockedCoverage",
        "AwaitingReview",
        "Approved",
        "Rejected",
        "AutoApproved",
        "AwaitingRemovalApproval"
      ]
    },
    "coveragePct": { "type": "number" },
    "userAcceptedGaps": { "type": "boolean" },
    "tcDeltaReportPath": { "type": ["string", "null"] },
    "pendingRetireCount": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
